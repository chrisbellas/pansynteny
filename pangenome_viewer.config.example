# Example config for pangenome_viewer.py / pgv_lookup.py.
#
# Copy this file to "pangenome_viewer.config" (no ".example") in the same
# directory as the scripts and fill in absolute paths for your dataset --
# it's picked up automatically, no --config flag needed. Any value can
# instead be passed as a CLI flag (e.g. --panaroo-csv ...), which overrides
# whatever is set here. Blank/missing values are treated as "not set".
#
# Only panaroo_csv and prokka_dir are required. Everything else is
# optional -- see the module docstring in pangenome_viewer.py for exactly
# which feature turns off when a given key is left blank.
#
# The non-path values below (column names, suffixes) are pre-filled with
# this deployment's actual values as a realistic starting point -- replace
# them with whatever your own metadata table actually uses.

# --- required ---
# panaroo gene_presence_absence.csv full path
panaroo_csv =
#  full path to prokka directory
prokka_dir =

# --- optional: genome metadata (serotype/host grouping, row labels, and
# the generic column/value filter boxes). metadata_join_col is the only
# required column here (the join key against each genome's genome_id);
# metadata_o_antigen_col + metadata_h_antigen_col (needed together, for a
# computed "O:H" serotype label) and metadata_source_col are each
# independently optional. The file can carry any number of other columns
# too -- every one of them shows up as its own generic column/value
# filter box, unused ones included. E.g.:
#
#   Assembly barcode(Assembly stats)  O Antigen(Serotype Prediction)  H Antigen(Serotype Prediction)  Source Type
#   ESC_WC2492AA_AS                   O157                            H7                               Ovine/Goat (Caprinae)
#
metadata_tsv =
metadata_join_col = Assembly barcode(Assembly stats)
metadata_o_antigen_col = O Antigen(Serotype Prediction)
metadata_h_antigen_col = H Antigen(Serotype Prediction)
metadata_source_col = Source Type

# --- optional: RFE feature-importance coloring (expects a tab-delimited
# file with a "feature" column (required -- the Panaroo cluster name,
# possibly "~~~"-merged) plus "importance" and "Annotation" (both
# optional, and independent of each other -- "Annotation" is a curated
# short name, e.g. "nleC", that supersedes the Prokka annotation in the
# legend/tooltip/search when present; note the capital A, a lowercase
# "annotation" column is not read). Any other columns present are just
# ignored, e.g.:
#
#   feature       importance          Annotation
#   group_10695   0.012300539192215   nleC
#
# ) ---
rfe_features_txt =

# --- optional: MGE-type labels (genomad combined output) -expects a
# tab-delimited file with pangenome_gene_cluster/genome_id/locus_tag/
# mge_type columns -- any other columns present are just ignored, e.g.:
#
#   pangenome_gene_cluster  genome_id       locus_tag       mge_type
#   group_10918             ESC_AA7970AA_AS HJIKEAHO_00003  virus
#
# ) ---
mge_genes_tsv =

# --- optional: cosmetic only -- comma-separated suffixes to strip from a
# Panaroo/Prokka genome-column "stem" for a shorter display genome_id,
# e.g. ".result,.scaffold" ---
strip_genome_suffixes = .result,.scaffold
